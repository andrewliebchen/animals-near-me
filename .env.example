# Server API URL (for client)
EXPO_PUBLIC_API_URL=https://your-app.vercel.app/api

# Supabase Configuration (for filter storage and seen observations tracking)
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-side (Vercel environment variables)
# EBIRD_API_KEY=your_ebird_api_key_here

